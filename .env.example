# Res+ environment variables. Copy to .env.local and fill in real values.
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.
# NEVER put real values in this file - it is committed to a public repo.

# Supabase (new key system: publishable + secret)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx          # server only (admin scripts, privileged writes)

# Agora
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=                      # server only (token generation)
AGORA_CUSTOMER_ID=                          # server only (STT REST API)
AGORA_CUSTOMER_SECRET=                      # server only

# AWS Bedrock
AWS_ACCESS_KEY_ID=                          # server only
AWS_SECRET_ACCESS_KEY=                      # server only
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=


# TomTom (map tiles, live traffic heat map, routing). Free account at my.tomtom.com.
# Browser key: set a domain whitelist on it in the TomTom dashboard.
NEXT_PUBLIC_TOMTOM_KEY=cVCtK7G7VM52DnmZ4rV5LP50v9rRF1kE
TOMTOM_ROUTING_KEY=    
                     # optional, server only (/api/routes); falls back to the browser key
